{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
            "!**/dist",
            "!**/node_modules"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "useHookAtTopLevel": "error",
                "useExhaustiveDependencies": "warn"
            },
            "style": {
                "useComponentExportOnlyModules": {
                    "level": "warn",
                    "options": {
                        "allowConstantExport": true
                    }
                }
            }
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    }
}
