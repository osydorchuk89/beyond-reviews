{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}",
            "!**/dist",
            "!**/node_modules",
            "!prisma/generated"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    }
}
